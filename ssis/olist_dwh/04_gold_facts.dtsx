                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT i.order_id,
       i.order_item_id,
       i.product_id,
       i.seller_id,
       o.order_status,
       ISNULL(dd.date_key, -1)     AS date_key,
       ISNULL(dc.customer_key, -1) AS customer_key,
       i.price,
       i.freight_value,
       i.total_item_value,
       CASE WHEN o.delivered_customer_ts IS NULL THEN NULL
            ELSE DATEDIFF(DAY, o.order_purchase_ts, o.delivered_customer_ts) END AS days_to_deliver,
       CASE WHEN o.delivered_customer_ts IS NULL OR o.estimated_delivery_ts IS NULL THEN NULL
            ELSE DATEDIFF(DAY, o.estimated_delivery_ts, o.delivered_customer_ts) END AS delivery_delay_days,
       CAST(CASE WHEN o.delivered_customer_ts IS NULL OR o.estimated_delivery_ts IS NULL THEN NULL
                 WHEN DATEDIFF(DAY, o.estimated_delivery_ts, o.delivered_customer_ts) &gt; 0 THEN 1
                 ELSE 0 END AS BIT) AS is_late
FROM silver.order_items i
JOIN silver.orders o              ON o.order_id = i.order_id
LEFT JOIN silver.customers c      ON c.customer_id = o.customer_id
LEFT JOIN gold.dim_customer dc    ON dc.customer_unique_id = c.customer_unique_id
                                 AND CAST(o.order_purchase_ts AS DATE) BETWEEN dc.valid_from AND dc.valid_to
LEFT JOIN gold.dim_date dd        ON dd.full_date = CAST(o.order_purchase_ts AS DATE);</property>
                <property
