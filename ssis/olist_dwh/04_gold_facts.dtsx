    <DTS:Executable
      DTS:refId="Package\sql_fact_reviews"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F3F0F20C-1B27-4086-B05E-6C1017B143B7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sql_fact_reviews"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5FED82-6364-49B9-8B90-152C45C2FFCA}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO gold.fact_reviews (review_id, order_id, date_key, customer_key, review_score)&#xA;SELECT r.review_id,&#xA;       r.order_id,&#xA;       ISNULL(dd.date_key, -1),&#xA;       ISNULL(dc.customer_key, -1),&#xA;       r.review_score&#xA;FROM silver.order_reviews r&#xA;LEFT JOIN silver.orders o         ON o.order_id = r.order_id&#xA;LEFT JOIN silver.customers c      ON c.customer_id = o.customer_id&#xA;LEFT JOIN gold.dim_customer dc    ON dc.customer_unique_id = c.customer_unique_id&#xA;                                 AND CAST(o.order_purchase_ts AS DATE) BETWEEN dc.valid_from AND dc.valid_to&#xA;LEFT JOIN gold.dim_date dd        ON dd.full_date = CAST(r.review_creation_ts AS DATE);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\sql_log_gold_fact_counts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C8BBBC62-A844-4308-A817-1FA45626E20B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sql_log_gold_fact_counts"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5FED82-6364-49B9-8B90-152C45C2FFCA}"
          SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;INSERT INTO etl.load_log (batch_id, package, table_name, rows_read, rows_written, rows_error)&#xA;SELECT @batch_id, '04_gold_facts', 'gold.fact_sales',    (SELECT COUNT(*) FROM silver.order_items),    (SELECT COUNT(*) FROM gold.fact_sales),    0&#xA;UNION ALL SELECT @batch_id, '04_gold_facts', 'gold.fact_payments', (SELECT COUNT(*) FROM silver.order_payments), (SELECT COUNT(*) FROM gold.fact_payments), 0&#xA;UNION ALL SELECT @batch_id, '04_gold_facts', 'gold.fact_reviews',  (SELECT COUNT(*) FROM silver.order_reviews),  (SELECT COUNT(*) FROM gold.fact_reviews),  0;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
