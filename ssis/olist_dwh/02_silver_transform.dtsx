      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5FED82-6364-49B9-8B90-152C45C2FFCA}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; SET XACT_ABORT ON;&#xA;DECLARE @batch_id INT = ?;&#xA;BEGIN TRAN;&#xA;TRUNCATE TABLE silver.sellers;&#xA;&#xA;INSERT INTO etl.error_rows (batch_id, table_name, error_code, error_column, raw_row)&#xA;SELECT @batch_id, 'silver.sellers', 2, 'seller_id',&#xA;       CONCAT_WS('|', seller_id, seller_zip_code_prefix, seller_city, seller_state)&#xA;FROM bronze.olist_sellers&#xA;WHERE NULLIF(TRIM(seller_id), '') IS NULL;&#xA;&#xA;INSERT INTO silver.sellers (seller_id, zip_code_prefix, city, state)&#xA;SELECT TRIM(seller_id),&#xA;       RIGHT('00000' + NULLIF(TRIM(seller_zip_code_prefix), ''), 5),&#xA;       silver.fn_proper_case(seller_city),&#xA;       UPPER(TRIM(seller_state))&#xA;FROM bronze.olist_sellers&#xA;WHERE NULLIF(TRIM(seller_id), '') IS NOT NULL;&#xA;COMMIT;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="$Package::batch_id"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
