    <DTS:Executable
      DTS:refId="Package\sql_log_silver_counts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{e0c9b962-b5f4-4866-bc9b-f27f449e91fe}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sql_log_silver_counts"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5FED82-6364-49B9-8B90-152C45C2FFCA}"
          SQLTask:SqlStatementSource="DECLARE @batch_id INT = ?;&#xA;&#xA;INSERT INTO etl.load_log (batch_id, package, table_name, rows_read, rows_written, rows_error)&#xA;SELECT @batch_id, '02_silver_transform', v.table_name, v.rows_read, v.rows_written,&#xA;       (SELECT COUNT(*) FROM etl.error_rows e WHERE e.batch_id = @batch_id AND e.table_name = v.table_name)&#xA;FROM (&#xA;    SELECT 'silver.category_translation' AS table_name, (SELECT COUNT(*) FROM bronze.product_category_name_translation) AS rows_read, (SELECT COUNT(*) FROM silver.category_translation) AS rows_written&#xA;    UNION ALL SELECT 'silver.geolocation',   (SELECT COUNT(*) FROM bronze.olist_geolocation),    (SELECT COUNT(*) FROM silver.geolocation)&#xA;    UNION ALL SELECT 'silver.customers',     (SELECT COUNT(*) FROM bronze.olist_customers),      (SELECT COUNT(*) FROM silver.customers)&#xA;    UNION ALL SELECT 'silver.sellers',       (SELECT COUNT(*) FROM bronze.olist_sellers),        (SELECT COUNT(*) FROM silver.sellers)&#xA;    UNION ALL SELECT 'silver.products',      (SELECT COUNT(*) FROM bronze.olist_products),       (SELECT COUNT(*) FROM silver.products)&#xA;    UNION ALL SELECT 'silver.orders',        (SELECT COUNT(*) FROM bronze.olist_orders),         (SELECT COUNT(*) FROM silver.orders)&#xA;    UNION ALL SELECT 'silver.order_items',   (SELECT COUNT(*) FROM bronze.olist_order_items),    (SELECT COUNT(*) FROM silver.order_items)&#xA;    UNION ALL SELECT 'silver.order_payments',(SELECT COUNT(*) FROM bronze.olist_order_payments), (SELECT COUNT(*) FROM silver.order_payments)&#xA;    UNION ALL SELECT 'silver.order_reviews', (SELECT COUNT(*) FROM bronze.olist_order_reviews),  (SELECT COUNT(*) FROM silver.order_reviews)&#xA;) v;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\sql_silver_category_translation"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{31E09BA3-614C-4D8B-B582-6D2DFF4FFD45}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sql_silver_category_translation"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5FED82-6364-49B9-8B90-152C45C2FFCA}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; SET XACT_ABORT ON;&#xA;BEGIN TRAN;&#xA;TRUNCATE TABLE silver.category_translation;&#xA;&#xA;INSERT INTO silver.category_translation (category_pt, category_en)&#xA;SELECT LOWER(TRIM(product_category_name)), LOWER(TRIM(product_category_name_english))&#xA;FROM bronze.product_category_name_translation&#xA;WHERE NULLIF(TRIM(product_category_name), '') IS NOT NULL;&#xA;&#xA;-- Two categories are missing from the source file, so we add them&#xA;INSERT INTO silver.category_translation (category_pt, category_en)&#xA;SELECT v.category_pt, v.category_en&#xA;FROM (VALUES ('pc_gamer', 'pc_gamer'),&#xA;             ('portateis_cozinha_e_preparadores_de_alimentos', 'portable_kitchen_and_food_preparers')) AS v (category_pt, category_en)&#xA;WHERE NOT EXISTS (SELECT 1 FROM silver.category_translation t WHERE t.category_pt = v.category_pt);&#xA;COMMIT;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\sql_silver_customers"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{63eac397-fc31-425a-af8a-af53c0826efa}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sql_silver_customers"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5FED82-6364-49B9-8B90-152C45C2FFCA}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; SET XACT_ABORT ON;&#xA;DECLARE @batch_id INT = ?;&#xA;BEGIN TRAN;&#xA;TRUNCATE TABLE silver.customers;&#xA;&#xA;INSERT INTO etl.error_rows (batch_id, table_name, error_code, error_column, raw_row)&#xA;SELECT @batch_id, 'silver.customers', 2, 'customer_id or customer_unique_id',&#xA;       CONCAT_WS('|', customer_id, customer_unique_id, customer_zip_code_prefix, customer_city, customer_state)&#xA;FROM bronze.olist_customers&#xA;WHERE NULLIF(TRIM(customer_id), '') IS NULL OR NULLIF(TRIM(customer_unique_id), '') IS NULL;&#xA;&#xA;INSERT INTO silver.customers (customer_id, customer_unique_id, zip_code_prefix, city, state)&#xA;SELECT TRIM(customer_id),&#xA;       TRIM(customer_unique_id),&#xA;       RIGHT('00000' + NULLIF(TRIM(customer_zip_code_prefix), ''), 5),&#xA;       silver.fn_proper_case(customer_city),&#xA;       UPPER(TRIM(customer_state))&#xA;FROM bronze.olist_customers&#xA;WHERE NULLIF(TRIM(customer_id), '') IS NOT NULL&#xA;  AND NULLIF(TRIM(customer_unique_id), '') IS NOT NULL;&#xA;COMMIT;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="$Package::batch_id"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\sql_silver_geolocation"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{79CD2080-92A0-4EE4-AC28-200BCCE8329A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sql_silver_geolocation"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5FED82-6364-49B9-8B90-152C45C2FFCA}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; SET XACT_ABORT ON;&#xA;BEGIN TRAN;&#xA;TRUNCATE TABLE silver.geolocation;&#xA;&#xA;WITH cleaned AS (&#xA;    SELECT RIGHT('00000' + TRIM(geolocation_zip_code_prefix), 5) AS zip_code_prefix,&#xA;           TRY_CAST(geolocation_lat AS DECIMAL(18,9)) AS lat,&#xA;           TRY_CAST(geolocation_lng AS DECIMAL(18,9)) AS lng,&#xA;           LOWER(TRIM(geolocation_city))  AS city,&#xA;           UPPER(TRIM(geolocation_state)) AS state&#xA;    FROM bronze.olist_geolocation&#xA;    WHERE NULLIF(TRIM(geolocation_zip_code_prefix), '') IS NOT NULL&#xA;),&#xA;averages AS (&#xA;    SELECT zip_code_prefix, AVG(lat) AS lat, AVG(lng) AS lng&#xA;    FROM cleaned GROUP BY zip_code_prefix&#xA;),&#xA;city_counts AS (&#xA;    SELECT zip_code_prefix, city, state,&#xA;           ROW_NUMBER() OVER (PARTITION BY zip_code_prefix ORDER BY COUNT(*) DESC, city) AS rn&#xA;    FROM cleaned GROUP BY zip_code_prefix, city, state&#xA;)&#xA;INSERT INTO silver.geolocation (zip_code_prefix, latitude, longitude, city, state)&#xA;SELECT a.zip_code_prefix,&#xA;       CAST(a.lat AS DECIMAL(9,6)),&#xA;       CAST(a.lng AS DECIMAL(9,6)),&#xA;       silver.fn_proper_case(c.city),&#xA;       c.state&#xA;FROM averages a&#xA;JOIN city_counts c ON c.zip_code_prefix = a.zip_code_prefix AND c.rn = 1;&#xA;COMMIT;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\sql_silver_orders"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{069a1ded-497a-42c0-8840-382b7bd79953}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sql_silver_orders"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5FED82-6364-49B9-8B90-152C45C2FFCA}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; SET XACT_ABORT ON;&#xA;DECLARE @batch_id INT = ?;&#xA;DROP TABLE IF EXISTS #src_orders;&#xA;BEGIN TRAN;&#xA;TRUNCATE TABLE silver.orders;&#xA;&#xA;SELECT *,&#xA;       CASE WHEN NULLIF(TRIM(order_id), '') IS NULL OR NULLIF(TRIM(customer_id), '') IS NULL THEN 2&#xA;            WHEN NULLIF(TRIM(order_purchase_timestamp), '') IS NOT NULL&#xA;                 AND TRY_CAST(TRIM(order_purchase_timestamp) AS DATETIME2) IS NULL THEN 1&#xA;            ELSE 0 END AS bad_code&#xA;INTO #src_orders&#xA;FROM bronze.olist_orders;&#xA;&#xA;INSERT INTO etl.error_rows (batch_id, table_name, error_code, error_column, raw_row)&#xA;SELECT @batch_id, 'silver.orders', bad_code, 'order_id, customer_id or order_purchase_timestamp',&#xA;       CONCAT_WS('|', order_id, customer_id, order_status, order_purchase_timestamp)&#xA;FROM #src_orders WHERE bad_code &gt; 0;&#xA;&#xA;INSERT INTO silver.orders (order_id, customer_id, order_status, is_delivered, order_purchase_ts, order_approved_ts,&#xA;                           delivered_carrier_ts, delivered_customer_ts, estimated_delivery_ts)&#xA;SELECT TRIM(order_id),&#xA;       TRIM(customer_id),&#xA;       LOWER(TRIM(order_status)),&#xA;       CASE WHEN LOWER(TRIM(order_status)) = 'delivered' THEN 1 ELSE 0 END,&#xA;       TRY_CAST(NULLIF(TRIM(order_purchase_timestamp), '')      AS DATETIME2),&#xA;       TRY_CAST(NULLIF(TRIM(order_approved_at), '')             AS DATETIME2),&#xA;       TRY_CAST(NULLIF(TRIM(order_delivered_carrier_date), '')  AS DATETIME2),&#xA;       TRY_CAST(NULLIF(TRIM(order_delivered_customer_date), '') AS DATETIME2),&#xA;       TRY_CAST(NULLIF(TRIM(order_estimated_delivery_date), '') AS DATETIME2)&#xA;FROM #src_orders WHERE bad_code = 0;&#xA;COMMIT;&#xA;&#xA;DROP TABLE IF EXISTS #src_orders;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="$Package::batch_id"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\sql_silver_order_payments"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{68f9713f-04d6-479d-b10a-92f2ce74e424}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sql_silver_order_payments"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5FED82-6364-49B9-8B90-152C45C2FFCA}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; SET XACT_ABORT ON;&#xA;DECLARE @batch_id INT = ?;&#xA;DROP TABLE IF EXISTS #src_payments;&#xA;BEGIN TRAN;&#xA;TRUNCATE TABLE silver.order_payments;&#xA;&#xA;SELECT *,&#xA;       CASE WHEN NULLIF(TRIM(order_id), '') IS NULL OR NULLIF(TRIM(payment_sequential), '') IS NULL THEN 2&#xA;            WHEN TRY_CAST(TRIM(payment_sequential) AS INT) IS NULL&#xA;              OR TRY_CAST(TRIM(payment_value) AS DECIMAL(10,2)) IS NULL THEN 1&#xA;            ELSE 0 END AS bad_code&#xA;INTO #src_payments&#xA;FROM bronze.olist_order_payments;&#xA;&#xA;INSERT INTO etl.error_rows (batch_id, table_name, error_code, error_column, raw_row)&#xA;SELECT @batch_id, 'silver.order_payments', bad_code, 'order_id, payment_sequential or payment_value',&#xA;       CONCAT_WS('|', order_id, payment_sequential, payment_type, payment_installments, payment_value)&#xA;FROM #src_payments WHERE bad_code &gt; 0;&#xA;&#xA;INSERT INTO silver.order_payments (order_id, payment_sequential, payment_type, payment_installments, payment_value)&#xA;SELECT TRIM(order_id),&#xA;       TRY_CAST(TRIM(payment_sequential) AS INT),&#xA;       CASE WHEN NULLIF(LOWER(TRIM(payment_type)), '') IS NULL OR LOWER(TRIM(payment_type)) = 'not_defined'&#xA;            THEN 'Unknown' ELSE LOWER(TRIM(payment_type)) END,&#xA;       TRY_CAST(TRIM(payment_installments) AS INT),&#xA;       TRY_CAST(TRIM(payment_value) AS DECIMAL(10,2))&#xA;FROM #src_payments WHERE bad_code = 0;&#xA;COMMIT;&#xA;&#xA;DROP TABLE IF EXISTS #src_payments;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\sql_silver_order_reviews"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{507dfadc-ea00-4bf0-99be-b6b8b6f7bbcb}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sql_silver_order_reviews"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5FED82-6364-49B9-8B90-152C45C2FFCA}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; SET XACT_ABORT ON;&#xA;DECLARE @batch_id INT = ?;&#xA;DROP TABLE IF EXISTS #src_reviews;&#xA;BEGIN TRAN;&#xA;TRUNCATE TABLE silver.order_reviews;&#xA;&#xA;SELECT *,&#xA;       CASE WHEN NULLIF(TRIM(review_id), '') IS NULL OR NULLIF(TRIM(order_id), '') IS NULL THEN 2&#xA;            WHEN TRY_CAST(TRIM(review_score) AS TINYINT) IS NULL THEN 1&#xA;            ELSE 0 END AS bad_code&#xA;INTO #src_reviews&#xA;FROM bronze.olist_order_reviews;&#xA;&#xA;INSERT INTO etl.error_rows (batch_id, table_name, error_code, error_column, raw_row)&#xA;SELECT @batch_id, 'silver.order_reviews', bad_code, 'review_id, order_id or review_score',&#xA;       CONCAT_WS('|', review_id, order_id, review_score, review_creation_date)&#xA;FROM #src_reviews WHERE bad_code &gt; 0;&#xA;&#xA;INSERT INTO silver.order_reviews (review_id, order_id, review_score, comment_title, comment_message,&#xA;                                  review_creation_ts, review_answer_ts)&#xA;SELECT review_id, order_id, review_score, comment_title, comment_message, review_creation_ts, review_answer_ts&#xA;FROM (&#xA;    SELECT TRIM(review_id) AS review_id,&#xA;           TRIM(order_id)  AS order_id,&#xA;           TRY_CAST(TRIM(review_score) AS TINYINT) AS review_score,&#xA;           NULLIF(TRIM(review_comment_title), '')   AS comment_title,&#xA;           NULLIF(TRIM(review_comment_message), '') AS comment_message,&#xA;           TRY_CAST(NULLIF(TRIM(review_creation_date), '')    AS DATETIME2) AS review_creation_ts,&#xA;           TRY_CAST(NULLIF(TRIM(review_answer_timestamp), '') AS DATETIME2) AS review_answer_ts,&#xA;           ROW_NUMBER() OVER (PARTITION BY TRIM(review_id)&#xA;                              ORDER BY TRY_CAST(NULLIF(TRIM(review_answer_timestamp), '') AS DATETIME2) DESC,&#xA;                                       TRY_CAST(NULLIF(TRIM(review_creation_date), '') AS DATETIME2) DESC,&#xA;                                       TRIM(order_id) DESC) AS rn&#xA;    FROM #src_reviews&#xA;    WHERE bad_code = 0&#xA;) r&#xA;WHERE rn = 1;&#xA;COMMIT;&#xA;&#xA;DROP TABLE IF EXISTS #src_reviews;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\sql_silver_products"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{a3f4645b-c345-44f8-8094-480e07c79550}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sql_silver_products"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1A5FED82-6364-49B9-8B90-152C45C2FFCA}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; SET XACT_ABORT ON;&#xA;DECLARE @batch_id INT = ?;&#xA;BEGIN TRAN;&#xA;TRUNCATE TABLE silver.products;&#xA;&#xA;INSERT INTO etl.error_rows (batch_id, table_name, error_code, error_column, raw_row)&#xA;SELECT @batch_id, 'silver.products', 2, 'product_id',&#xA;       CONCAT_WS('|', product_id, product_category_name)&#xA;FROM bronze.olist_products&#xA;WHERE NULLIF(TRIM(product_id), '') IS NULL;&#xA;&#xA;INSERT INTO silver.products (product_id, category_pt, category_en, product_name_length, product_description_length,&#xA;                             photos_qty, weight_g, length_cm, height_cm, width_cm)&#xA;SELECT TRIM(p.product_id),&#xA;       ISNULL(NULLIF(LOWER(TRIM(p.product_category_name)), ''), 'Unknown'),&#xA;       COALESCE(t.category_en, 'Unknown'),&#xA;       TRY_CAST(TRY_CAST(NULLIF(TRIM(p.product_name_lenght), '')        AS DECIMAL(18,2)) AS INT),&#xA;       TRY_CAST(TRY_CAST(NULLIF(TRIM(p.product_description_lenght), '') AS DECIMAL(18,2)) AS INT),&#xA;       TRY_CAST(TRY_CAST(NULLIF(TRIM(p.product_photos_qty), '')         AS DECIMAL(18,2)) AS INT),&#xA;       TRY_CAST(TRY_CAST(NULLIF(TRIM(p.product_weight_g), '')           AS DECIMAL(18,2)) AS INT),&#xA;       TRY_CAST(TRY_CAST(NULLIF(TRIM(p.product_length_cm), '')          AS DECIMAL(18,2)) AS INT),&#xA;       TRY_CAST(TRY_CAST(NULLIF(TRIM(p.product_height_cm), '')          AS DECIMAL(18,2)) AS INT),&#xA;       TRY_CAST(TRY_CAST(NULLIF(TRIM(p.product_width_cm), '')           AS DECIMAL(18,2)) AS INT)&#xA;FROM bronze.olist_products p&#xA;LEFT JOIN silver.category_translation t ON t.category_pt = LOWER(TRIM(p.product_category_name))&#xA;WHERE NULLIF(TRIM(p.product_id), '') IS NOT NULL;&#xA;COMMIT;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="$Package::batch_id"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\sql_silver_sellers"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{ae4d8513-da8d-4436-82aa-66bfa7570e62}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sql_silver_sellers"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
