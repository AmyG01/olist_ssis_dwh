                  <properties>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the expression. This expression version uses lineage identifiers instead of column names."
                      name="Expression">[ISNULL](#{Package\df_silver_order_items\src_bronze_order_items.Outputs[OLE DB Source Output].Columns[order_id]}) || [ISNULL](#{Package\df_silver_order_items\src_bronze_order_items.Outputs[OLE DB Source Output].Columns[product_id]}) || [ISNULL](#{Package\df_silver_order_items\src_bronze_order_items.Outputs[OLE DB Source Output].Columns[seller_id]}) || [LEN](#{Package\df_silver_order_items\src_bronze_order_items.Outputs[OLE DB Source Output].Columns[order_id]}) == 0 || [LEN](#{Package\df_silver_order_items\src_bronze_order_items.Outputs[OLE DB Source Output].Columns[product_id]}) == 0 || [LEN](#{Package\df_silver_order_items\src_bronze_order_items.Outputs[OLE DB Source Output].Columns[seller_id]}) == 0 || #{Package\df_silver_order_items\Data Conversion.Outputs[Data Conversion Output].Columns[price_dec]} &lt; 0 || #{Package\df_silver_order_items\Data Conversion.Outputs[Data Conversion Output].Columns[freight_value_dec]} &lt; 0</property>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the friendly version of the expression. This expression version uses column names."
                      expressionType="Notify"
                      name="FriendlyExpression">ISNULL(order_id) || ISNULL(product_id) || ISNULL(seller_id) || LEN(order_id) == 0 || LEN(product_id) == 0 || LEN(seller_id) == 0 || price_dec &lt; 0 || freight_value_dec &lt; 0</property>
                    <property
                      dataType="System.Int32"
                      description="Specifies the position of the condition in the list of conditions that the transformation evaluates. The evaluation order is from the lowest to the highest value."
